# Copy to functions/.env. Every value is optional — the defaults are correct
# for a plain deploy of this codebase to feston-prod.

# Public base of the customer link; "?t=<token>" is appended. This is the
# {CONFIRM_URL} the mobile app is configured with, and it must match the
# Hosting rewrite that maps a path to this function.
# Default: https://feston-prod.web.app/app/register/confirm
#
# NOT www.festonsev.com — that is a WordPress site on other infrastructure and
# cannot rewrite to a Cloud Function. For a Feston-branded link, add a
# subdomain to Firebase Hosting first and point this at it.
# CONFIRM_PUBLIC_BASE_URL=https://register.festonsev.com/app/register/confirm

# Absolute URL of a publicly-readable Feston logo. Unset renders a styled
# "FESTON" wordmark instead, which keeps the page to a single request.
# CONFIRM_LOGO_URL=https://feston-prod.web.app/assets/images/feston-logo.png

# Link lifetime in minutes, used by the dev server and the docs only. The
# deadline actually enforced is the `expiresAt` the mobile app writes onto the
# pending document — this service never mints one.
# CONFIRM_TTL_MINUTES=2880

# Collection overrides. Change only if these collections are ever renamed.
# PENDING_COLLECTION=pending_registrations
# REGISTRATIONS_COLLECTION=registered_products
# SERIALS_COLLECTION=serial_num
