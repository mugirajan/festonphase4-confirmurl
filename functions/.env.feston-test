# Used ONLY by `firebase deploy --project feston-test` (Firebase loads
# .env.<projectId>), never by a feston-prod deploy. Test copy, 2026-10-20.

# The customer link the test app shares — a real https address, so chat apps
# show it as a link and any phone can open it.
CONFIRM_PUBLIC_BASE_URL=https://us-central1-feston-test.cloudfunctions.net/confirm

# The confirm page signs the customer in for the OTP with feston-test's web app.
CONFIRM_FIREBASE_API_KEY=AIzaSyC8WpUZwf05TLVrirSwO_wtpHCrVjBIo9w
CONFIRM_FIREBASE_AUTH_DOMAIN=feston-test.firebaseapp.com
CONFIRM_FIREBASE_PROJECT_ID=feston-test
CONFIRM_FIREBASE_APP_ID=1:910738295581:web:45ec6d3ac93d795516eff4

# OTP on with the normal reCAPTCHA: test numbers (feston-test list) AND real
# numbers both work. Needs us-central1-feston-test.cloudfunctions.net in
# Authentication → Settings → Authorized domains.
CONFIRM_OTP_ENABLED=true
CONFIRM_OTP_TEST_MODE=false

# Hero certificates issue into feston-test's bucket; no email to anyone.
HERO_BUCKET=feston-test.firebasestorage.app
HERO_EMAIL_ENABLED=false
